# Copy to .env.local. Names follow docs/04-engineering/environments-and-deploy.md.
# Values are never committed; in the cloud they are environment secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (M5): the dev project, Mumbai region.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres for Drizzle. Locally: postgresql://postgres:postgres@localhost:5432/agency_os
DATABASE_URL=
DATABASE_URL_DIRECT=
# Database tests create and drop throwaway databases on this server.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Razorpay test mode (M6): Agency OS's own subscriptions.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local review without a database: the workspace screens show labelled example data and skip sign-in.
# Never set in production.
EXAMPLE_MODE=false
# Phone OTP sign-in (needs an SMS provider in Supabase).
NEXT_PUBLIC_PHONE_OTP=false
