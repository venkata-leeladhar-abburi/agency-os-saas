{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "env": ["TEST_DATABASE_URL"] },
    "dev": { "cache": false, "persistent": true }
  }
}
